# Makefile for GC-specific code

CXXFLAGS	+= -DHW_DOL -DUSE_TLB_CACHE -DTINY_TLBCACHE -D__gamecube__

LDFLAGS		+= -mogc

# See the note in Makefile.wii: accept either libogc2 layout. Upstream's install
# calls the GameCube directory "gamecube" where the prebuilt bundle calls it "cube".
#
# NOTE: this target does not currently link. Makefile.base asks for -lfat, and no
# libogc2 distribution ships libfat.a for GameCube -- neither the prebuilt bundle
# nor a from-source build, which produces only 8 cube libraries. Pre-existing, and
# unrelated to the toolchain: it fails identically on devkitPPC r41-2.
ifneq ($(wildcard $(DEVKITPRO)/libogc2/lib/cube),)
LIBPATHS	+= -L$(DEVKITPRO)/libogc2/lib/cube
INCLUDE 	+= -I$(DEVKITPRO)/libogc2/include
else
LIBPATHS	+= -L$(DEVKITPRO)/libogc2/gamecube/lib
INCLUDE 	+= -I$(DEVKITPRO)/libogc2/gamecube/include
endif

OBJ		+= \
		gc_memory/TLB-Cache.o \
		vm/vm.o \
		vm/dsihandler.o

LIB		+= -lz

