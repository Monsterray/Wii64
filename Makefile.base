# Makefile variables and targets used in all builds

CC  := $(DEVKITPPC)/bin/powerpc-eabi-gcc
CXX := $(DEVKITPPC)/bin/powerpc-eabi-g++
AS  := $(DEVKITPPC)/bin/powerpc-eabi-as



LTO			 = -flto -fno-strict-aliasing # Uncomment to use link-time optimization
DEBUG_FLAGS += #-DSHOW_DEBUG #-DPROFILE #-DDEBUGON #-DPRINTGECKO #-DGLN64_SDLOG #-DNO_BT #-DPERF_PROF

MACHDEP		+= -mcpu=750 -meabi -mhard-float 
LDFLAGS		+= -O3 $(LTO) $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--cref $(LTO)

INCLUDE 	+= -I$(DEVKITPRO)/portlibs/ppc/include
LIBPATHS	+= -L$(DEVKITPRO)/portlibs/ppc/lib

CXXFLAGS		+= \
		-g -O3 $(LTO) -Wall -Wextra -Wno-parentheses -Wno-unused-parameter -pipe $(MACHDEP) $(INCLUDE) \
		-DGEKKO -D__GX__ -DUSE_GUI -DRELEASE \
		-DUSE_RECOMP_CACHE -DPPC_DYNAREC -DFASTMEM -DFASTMEM_HOT_NOFLUSH -DNO_ASM \
		-Wstrict-aliasing=3 -Wcast-align -Wlto-type-mismatch -Wodr \
		-Wclobbered -Wvolatile-register-var -Winline -fno-toplevel-reorder -fno-strict-aliasing \
		-MMD -MP \
		$(DEBUG_FLAGS) $(FEATURES) #-fno-exceptions

# := forces immediate expansion here, snapshotting CXXFLAGS's value now (Makefile.base
# is always the last-included fragment, so this already has every plugin/platform flag).
# That snapshot matters because -Wno-register below only applies to C++ (the 'register'
# keyword removal is a C++17 change); appending it straight to CXXFLAGS with += would
# otherwise leak into this CFLAGS via lazy expansion and warn "invalid for C" on every
# .c file.
CFLAGS	:= $(CFLAGS) $(CXXFLAGS) -fgnu89-inline -Wno-multichar
CXXFLAGS	+= -Wno-register

OBJ		+= \
		main/gamehacks.o \
		main/rom_gc.o \
		main/ROM-Cache.o \
		main/main_gc-menu2.o \
		main/timers.o \
		main/boxart.o \
		main/boxart_resource.o \
		main/perf_prof.o \
		main/dynarec_trace.o \
		menu/MenuContext.o \
		menu/MainFrame.o \
		menu/MiniMenuFrame.o \
		menu/SelectRomFrame.o \
		menu/LoadRomFrame.o \
		menu/FileBrowserFrame.o \
		menu/ConfigureButtonsFrame.o\
		menu/ConfigureInputFrame.o\
		menu/ConfigurePaksFrame.o\
		menu/AdvancedAudioFrame.o\
		menu/CurrentRomFrame.o \
		menu/LoadSaveFrame.o \
		menu/SaveGameFrame.o \
		menu/SettingsFrame.o\
		menu/SelectCPUFrame.o\
		menu/MenuResources.o \
		libgui/Box3D.o \
		libgui/Button.o \
		libgui/Component.o \
		libgui/CursorManager.o \
		libgui/FocusManager.o \
		libgui/Frame.o \
		libgui/GraphicsGX.o \
		libgui/Gui.o \
		libgui/GuiResources.o \
		libgui/Image.o \
		libgui/InputManager.o \
		libgui/InputStatusBar.o \
		libgui/IPLFont.o \
		libgui/LoadingBar.o \
		libgui/Logo.o \
		libgui/MainInfoBar.o \
		libgui/MessageBox.o \
		libgui/MiniInfoBar.o \
		libgui/resources.o \
		libgui/TextBox.o \
		fileBrowser/gc_dvd.o \
		fileBrowser/fileBrowser-DVD.o \
		fileBrowser/fileBrowser-libfat.o \
		fileBrowser/fileBrowser.o \
		gui/DEBUG.o \
		r4300/r4300.o \
		r4300/exception.o \
		r4300/Invalid_Code.o \
		r4300/Recomp-Cache-Heap.o \
		gc_memory/tlb.o \
		gc_memory/memory.o \
		gc_memory/dma.o \
		r4300/interupt.o \
		r4300/recomp.o \
		gc_memory/n64_cic_nus_6105.o \
		gc_memory/pif.o \
		r4300/pure_interp.o \
		r4300/compare_core.o \
		gc_memory/flashram.o \
		main/md5.o \
		main/savestates_gc.o \
		r4300/profile.o \
		main/adler32.o
		
OBJ_PPC		+= \
		r4300/ppc/MIPS-to-PPC.o \
		r4300/ppc/Recompile.o \
		r4300/ppc/Wrappers.o \
		r4300/ppc/FuncTree.o \
		r4300/ppc/Register-Cache.o

OBJ_INPUT	+= \
		gc_input/input.o \
		gc_input/controller-GC.o

OBJ_RSPHLE	=rsp_hle/alist.o \
		rsp_hle/alist_audio.o \
		rsp_hle/alist_naudio.o \
		rsp_hle/alist_nead.o \
		rsp_hle/audio.o \
		rsp_hle/cicx105.o \
		rsp_hle/hle.o \
		rsp_hle/hvqm.o \
		rsp_hle/jpeg.o \
		rsp_hle/memory.o \
		rsp_hle/mp3.o \
		rsp_hle/musyx.o \
		rsp_hle/re2.o \
		rsp_hle/plugin.o

OBJ_AUDIO	+= \
		gc_audio/audio.o

HEADER		+= \
		main/rom.h \
		r4300/r4300.h \
		r4300/macros.h \
		r4300/exception.h \
		gc_memory/memory.h \
		gc_memory/tlb.h \
		gc_memory/dma.h \
		r4300/interupt.h \
		r4300/recomp.h \
		gc_memory/pif.h

r4300/Recomp-Cache-Heap.o: CFLAGS += -fno-lto 
r4300/ppc/Recompile.o: CFLAGS += -fno-lto 
r4300/ppc/Wrappers.o: CFLAGS += -fno-lto 
r4300/ppc/FuncTree.o: CFLAGS += -fno-lto 

LIB		+= -logc -lm -lfat -ldb -lz -laesnd -logc -static

ALL_OBJ		+= $(OBJ) $(OBJ_INPUT) $(OBJ_AUDIO) $(OBJ_RSPHLE) $(OBJ_PPC)

# -MMD -MP (above) writes a .d file per object with its actual header
# dependencies. Without this, a header-only change doesn't force its
# dependents to recompile -- caused a real ODR-violation/stale-object bug
# in an earlier session (MenuContext.h) that needed a full `make clean` to
# fix. Missing on the first build (no .d files yet); "-include" ignores
# that instead of erroring.
-include $(ALL_OBJ:.o=.d)

# The .d files above are read via -include, and each one is itself a rule
# (its object target with real prerequisites). Since that happens before
# "all:" is parsed, GNU Make's "first target in the first makefile" default
# goal silently became the first .d file's object instead of "all" --
# harmless-looking (a plain `make` with no target just did nothing, since
# that one object was already up to date) but wrong. Pin it explicitly.
.DEFAULT_GOAL := all

# The final link is always C++ (the project links libstdc++-using code
# regardless of plugin/platform), so this was never really conditional.
export LD	:=	$(CXX)

all:	$(DOL)

$(ELF):	$(ALL_OBJ)
	$(LD) $^ $(LDFLAGS) $(LIBPATHS) $(LIB) -o $@

$(DOL): $(ELF)
	elf2dol $(ELF) $(DOL)

# Scoped to this project's own source directories -- "find ." from the repo
# root would also delete .o/.d files under an unrelated in-progress build,
# e.g. inside a .claude/worktrees/* checkout.
CLEAN_DIRS	:= main menu libgui fileBrowser gui r4300 gc_memory gc_input \
		   rsp_hle gc_audio vm Rice_GX glN64_GX TextureArchive

clean:
	find $(CLEAN_DIRS) \( -name '*.o' -o -name '*.d' \) -print0 | xargs -0r rm -f

menu/MenuResources.o:		menu/MenuResources.s
		$(CC) -x assembler-with-cpp $(CFLAGS) -c -o $@ $<

vm/dsihandler.o:		vm/dsihandler.s
		$(CC) -x assembler-with-cpp $(CFLAGS) -D_LANGUAGE_ASSEMBLY -c -o $@ $<
