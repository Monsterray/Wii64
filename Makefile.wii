# Makefile for Wii-specific code

CXXFLAGS	+= -DWII -DHW_RVL -DUSE_EXPANSION -D__wii__

LDFLAGS		+= -mrvl

# libogc2 root: the side-by-side SDK that .dev/setup-devkitpro-windows.sh installs, when
# it exists, else devkitPro's own. Either install layout is accepted below.
LIBOGC2 ?= $(firstword $(wildcard $(DEVKITPRO)/wii64-sdk/libogc2) $(DEVKITPRO)/libogc2)
LIBOGC2_INCLUDE 	?= $(firstword $(wildcard $(LIBOGC2)/include) $(wildcard $(LIBOGC2)/wii/include))
LIBOGC2_WII_LIB 	?= $(firstword $(wildcard $(LIBOGC2)/lib/wii) $(wildcard $(LIBOGC2)/wii/lib))

ifeq ($(wildcard $(LIBOGC2_INCLUDE)/fat.h)$(filter clean,$(MAKECMDGOALS)),)
$(error libogc2 with libfat not found under $(LIBOGC2). On Windows run .dev/setup-devkitpro-windows.sh; see README.md "BUILDING FROM SOURCE")
endif

LIBPATHS 	+= -L$(LIBOGC2_WII_LIB)
INCLUDE 	+= -I$(LIBOGC2_INCLUDE)

OBJ		+= \
		vm/dsihandler.o \
		vm/wii_vm.o \
		vm/pagefile.o \
		main/wii.o \
		main/Autoboot.o

OBJ_INPUT	+= \
		gc_input/controller-Classic.o \
		gc_input/controller-WiimoteNunchuk.o

LIB		+= -lwiiuse -lbte -lz

# External HBC-Reborn SDK; opt-in development builds only.
ifeq ($(HBC_AGENT),1)
HBC_AGENT_ROOT ?= ../hbc-reborn
FEATURES += -DWII64_HBC_AGENT
INCLUDE += -I"$(HBC_AGENT_ROOT)/sdk"
LIBPATHS += -L"$(HBC_AGENT_ROOT)/sdk/hbc_agent/libogc2"
LIB := -lhbcagent $(LIB)
OBJ += main/dev_agent.o
endif
