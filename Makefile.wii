# Makefile for Wii-specific code

CXXFLAGS	+= -DWII -DHW_RVL -DUSE_EXPANSION -D__wii__

LDFLAGS		+= -mrvl

# libogc2 root: the side-by-side SDK that .dev/setup-devkitpro-windows.sh installs, when
# it exists, else devkitPro's own. Either install layout is accepted below.
LIBOGC2 ?= $(firstword $(wildcard $(DEVKITPRO)/wii64-sdk/libogc2) $(DEVKITPRO)/libogc2)
LIBOGC2_INCLUDE 	?= $(firstword $(wildcard $(LIBOGC2)/include) $(wildcard $(LIBOGC2)/wii/include))
LIBOGC2_WII_LIB 	?= $(firstword $(wildcard $(LIBOGC2)/lib/wii) $(wildcard $(LIBOGC2)/wii/lib))

ifeq ($(wildcard $(LIBOGC2_INCLUDE)/fat.h)$(filter clean,$(MAKECMDGOALS)),)
$(error libogc2 with libfat not found under $(LIBOGC2). On Windows run .dev/setup-devkitpro-windows.sh; see README.md "BUILDING FROM SOURCE")
endif

LIBPATHS 	+= -L$(LIBOGC2_WII_LIB)
INCLUDE 	+= -I$(LIBOGC2_INCLUDE)

OBJ		+= \
		vm/dsihandler.o \
		vm/wii_vm.o \
		vm/pagefile.o \
		main/wii.o \
		main/Autoboot.o

OBJ_INPUT	+= \
		gc_input/controller-Classic.o \
		gc_input/controller-WiimoteNunchuk.o

LIB		+= -lwiiuse -lbte -lz

# The HBC-Reborn agent is part of every Wii build: it is Wii64's HOME menu, and gives
# development builds status, file transfer, exit and crash reports (main/dev_agent.c,
# doc/rom-paging-and-agent.md). Its library must be built against the same libogc2:
# .dev/build_agent.sh builds it into .dev/hbc_agent. Else HBC-Reborn's own copy.
HBC_AGENT_ROOT ?= ../hbc-reborn
FEATURES += -DWII64_HBC_AGENT
INCLUDE += -I"$(HBC_AGENT_ROOT)/sdk"
HBC_AGENT_LIB ?= $(firstword $(wildcard .dev/hbc_agent/libhbcagent.a) $(wildcard $(HBC_AGENT_ROOT)/sdk/hbc_agent/libogc2/libhbcagent.a))
ifeq ($(HBC_AGENT_LIB)$(filter clean,$(MAKECMDGOALS)),)
$(error HBC agent library not found. Clone https://github.com/Monsterray/hbc-reborn beside Wii64 and run .dev/build_agent.sh (README.md "BUILDING FROM SOURCE"))
endif
LIBPATHS += -L"$(patsubst %/libhbcagent.a,%,$(HBC_AGENT_LIB))"
LIB := -lhbcagent $(LIB)
OBJ += main/dev_agent.o
OBJ += main/hprof.o main/hprof_entry.o
ifneq ($(filter -DPERF_HPROF,$(DEBUG_FLAGS)),)
LDFLAGS += '-Wl,--defsym,hprof_text_start=ADDR(.text),--defsym,hprof_text_end=ADDR(.text)+SIZEOF(.text)'
endif
# Crashes that skip the agent's hook still reach a report (main/dev_agent.c).
LDFLAGS += -Wl,--wrap,c_default_exceptionhandler
