# Makefile for Wii-specific code

CXXFLAGS	+= -DWII -DHW_RVL -DUSE_EXPANSION -D__wii__

LDFLAGS		+= -mrvl

# libogc2 exists in two layouts in the wild: the prebuilt bundle (libogc2/include
# with libogc2/lib/wii) and what upstream's own "make install" produces
# (libogc2/wii/include with libogc2/wii/lib). Accept either so a libogc2 built
# from source works without editing this file.
ifneq ($(wildcard $(DEVKITPRO)/libogc2/lib/wii),)
LIBPATHS 	+= -L$(DEVKITPRO)/libogc2/lib/wii
INCLUDE 	+= -I$(DEVKITPRO)/libogc2/include
else
LIBPATHS 	+= -L$(DEVKITPRO)/libogc2/wii/lib
INCLUDE 	+= -I$(DEVKITPRO)/libogc2/wii/include
endif

OBJ		+= \
		vm/dsihandler.o \
		vm/wii_vm.o \
		main/wii.o \
		main/Autoboot.o

OBJ_INPUT	+= \
		gc_input/controller-Classic.o \
		gc_input/controller-WiimoteNunchuk.o

LIB		+= -lwiiuse -lbte -lz

