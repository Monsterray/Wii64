# Makefile for Wii-specific code

CXXFLAGS	+= -DWII -DHW_RVL -DUSE_EXPANSION -D__wii__

LDFLAGS		+= -mrvl

LIBOGC2_INCLUDE 	?= $(firstword $(wildcard $(DEVKITPRO)/libogc2/include) $(wildcard $(DEVKITPRO)/libogc2/wii/include))
LIBOGC2_WII_LIB 	?= $(firstword $(wildcard $(DEVKITPRO)/libogc2/lib/wii) $(wildcard $(DEVKITPRO)/libogc2/wii/lib))

LIBPATHS 	+= -L$(LIBOGC2_WII_LIB)
INCLUDE 	+= -I$(LIBOGC2_INCLUDE)

OBJ		+= \
		vm/dsihandler.o \
		vm/wii_vm.o \
		main/wii.o \
		main/Autoboot.o

OBJ_INPUT	+= \
		gc_input/controller-Classic.o \
		gc_input/controller-WiimoteNunchuk.o

LIB		+= -lwiiuse -lbte -lz
